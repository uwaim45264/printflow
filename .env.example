# Copy to .env and fill in. .env is not committed.

# Supabase project (Dashboard → Project Settings → API).
# Public values — bundled into the web app:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET — used only by `npm run seed` on your computer (not needed if you create the admin in the SQL Editor).
# Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Super Admin login created by `npm run seed` (password: 8+ characters, letters and numbers).
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=


# Dev server port
PORT=3000
